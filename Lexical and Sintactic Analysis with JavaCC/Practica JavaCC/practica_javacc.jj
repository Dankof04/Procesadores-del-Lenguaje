options={DEBUG_TOKEN_MANAGER=true;}


PARSER_BEGIN(Parser_practica)

public class Parser_practica {

    int label=0

    public String siguiente_etiqueta(){
        return "LBL" + label++;
    }


    public static void main(String args[]) throws ParseException {
        Parser_practica parser = new Parser_practica(System.in);
        parser.list_sntncs();
}

}
PARSER_END(Parser_practica)

// Definición de los tokenes que representan espacios en blanco y comentarios, que serán ignorados por el parser
SKIP :
{
    < ESPACIO: " "+ > |
    < TABULACION: "\t"+ > |
    < SALTO_LINEA: "\n"+ > |
    < COMENTARIO_LINEA: "//" (~["\n"])* > |
    // /* comen * tario */
    < COMENTARIO_MULTI: "/*" (~["*"])* "*" ( ~["/"] (~["*"])* "*" )* "/" >
}

// Definición de los tokenes cuyas expresiones regulares contienen símbolos usados en la gramática
TOKEN:
{
    < PUNTO_COMA: ";" > |
    < PAREN_IZQ: "(" > |
    < PAREN_DER: ")" > |
    < LLAVE_IZQ: "{" > |
    < LLAVE_DER: "}" > |
    < IGUAL: "=" > |
    < MAS_IGUAL: "+=" > |
    < MENOS_IGUAL: "-=" > |
    < MULT_IGUAL: "*=" > |
    < DIV_IGUAL: "/=" > |
    < SUMA: "+" > |
    < RESTA: "-" > |
    < MULT: "*" > |
    < DIV: "/" >
}

// Definición de los tokenes cuyas expresiones regulares contienen palabras reservadas por la gramática
TOKEN:
{
    < IMPRIMIR: "imprimir" > |
    < SI: "si" > |
    < SINO: "sino" > |
    < MIENTRAS: "mientras" > |
    < HACER: "hacer" >
}

// Definición de los tokenes cuyas expresiones regulares contienen identificadores y números, axiomas de la gramática
TOKEN:
{
    < ID: ["a"-"z","A"-"Z","_"] (["a"-"z","A"-"Z","0"-"9","_"])* >   |
    < NUM: (["0"-"9"])+ >
}


void list_sntncs():
{}
{
    (sntnc() <PUNTO_COMA)* <EOF>
}

void sntnc():
{}
{
    sel_stmt() | iter_stmt() | assig_stmt() | print_stmt()
}

void print_stmt():
{}
{
    <IMPRIMIR> <PAREN_IZQ> expr() <PAREN_DER>
}


void sel_stmt():
{}
{
    <SI> <PAREN_IZQ> expr() <PAREN_DER> <LLAVE_IZQ> ( sntnc() <PUNTO_COMA> )* <LLAVE_DER> (<SINO> <LLAVE_IZQ> ( sntnc() <PUNTO_COMA> )* <LLAVE_DER>)?
}


void iter_stmt():
{}
{
    (<MIENTRAS> <PAREN_IZQ> expr() <PAREN_DER> <LLAVE_IZQ> ( sntnc() <PUNTO_COMA> )* <LLAVE_DER>) | (<HACER> <LLAVE_IZQ> ( sntnc() <PUNTO_COMA> )* <LLAVE_DER> <MIENTRAS> <PAREN_IZQ> expr() <PAREN_DER> )
}


void assig_stmt():
{}
{
    <ID> (<IGUAL> expr() | <MAS_IGUAL> expr() | <MENOS_IGUAL> expr() | <MULT_IGUAL> expr() | <DIV_IGUAL> expr())
}

void expr():
{}
{
    mult_expr() (<SUMA> mult_expr() 
    {
        System.out.println("\tsum ");
    }
    | <RESTA> mult_expr()
    {
        System.out.println("\tsub ");
    }
    )*
}

void mult_expr():
{}
{
    val() ( <DIV> val() 
    {
        System.out.println("\tdiv ");

    }
    | <MULT> val()
    {
        System.out.println("\tmul ");
    }
    )*
}

void val():
{
    Token t;
}
{
    t = <NUM> 
    {
        System.out.println("\tmete " + t.image);
    }
    |
    t= <ID> 
    {
        System.out.println("\tvalord " + t.image);
    }
    |
    <PAREN_IZQ> expr() <PAREN_DER>
}

